{
  "name": "react-locale-datepicker",
  "version": "0.4.0",
  "private": false,
  "description": "A React date picker that localizes itself from the Intl API — every locale, no locale files, RTL-aware.",
  "license": "MIT",
  "author": "Yevhen Salitrynskyi <ysalitrynskyi@gmail.com>",
  "keywords": [
    "react",
    "datepicker",
    "date-picker",
    "calendar",
    "i18n",
    "internationalization",
    "intl",
    "l10n",
    "rtl",
    "accessibility",
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ysalitrynskyi/react-locale-datepicker.git"
  },
  "bugs": {
    "url": "https://github.com/ysalitrynskyi/react-locale-datepicker/issues"
  },
  "homepage": "https://github.com/ysalitrynskyi/react-locale-datepicker#readme",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:tz": "TZ=UTC vitest run && TZ=America/Los_Angeles vitest run && TZ=Asia/Tokyo vitest run && TZ=Asia/Kathmandu vitest run",
    "test:e2e": "playwright test",
    "e2e:harness": "vite --config e2e/harness/vite.config.ts",
    "build": "tsup",
    "prepack": "npm run build",
    "check": "npm run typecheck && npm run lint && npm run test",
    "screenshots": "node scripts/capture-screenshots.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.5.2",
    "@vitest/coverage-v8": "^3.2.4",
    "axe-core": "^4.12.1",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.7.0",
    "jsdom": "^25.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tsup": "^8.5.1",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^6.4.3",
    "vitest": "^3.2.4",
    "vitest-axe": "^0.1.0"
  }
}
